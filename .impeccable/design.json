  "narrative": {
    "northStar": "Established BMA studio identity",
    "overview": "The established BMA identity uses pale blue space, dark ink and a restrained blue accent. Sora supplies the headings; Manrope supplies reading text, controls and selected compact titles. Open editorial arrangements sit alongside contained functional surfaces.\n\nThis is a source extraction of the incumbent system and its About/Contact extension on 22 October 2026, not a replacement identity. Sources: `style.css`, `services-story.css`, `portfolio-story.css`, `studio-pages.css`, `theo.css`, `john-mist.js`, `theo.js`, `booking.js`, `over-ons.html` and `contact.html`. This documentation pass did not inspect rendered output or operate a browser; screenshots in `.impeccable/review/studio-20261022/` belong to the separate finish review.",
    "keyCharacteristics": [
      "Pale blue continuity and generous spacing.",
      "Confident headings with readable supporting copy.",
      "Blue actions and quiet borders.",
      "Purposeful motion with reduced-motion handling."
    ],
    "rules": [],
    "dos": [
      "Do extend the existing Manrope/Sora pairing and root palette.",
      "Do use open rows for linked service summaries and contained surfaces for functional tools.",
      "Do preserve visible focus, direct calendar access and the email quote alternative.",
      "Do keep Nevel anchored and local to the assistant welcome state."
    ],
    "donts": [
